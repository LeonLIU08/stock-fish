FROM python:3.11-slim

# 本仓库仅包含 MiroFish backend（无 frontend / package.json）。
# 构建产物只提供 :5001 API，供 StockFish 推演桥接使用。
# camel-oasis 需要 cairo；LLM 走远程 API，不需要 GPU。

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    build-essential \
    curl \
    procps \
    pkg-config \
    libcairo2 \
    libcairo2-dev \
    libffi-dev \
    libgirepository1.0-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt /app/backend/requirements.txt
# 先装 CPU 版 PyTorch，并约束后续依赖不要换成 CUDA 轮子（Mac / 无 GPU 环境）
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip freeze | grep -E '^(torch|torchvision|torchaudio)==' > /tmp/torch-constraints.txt \
    && pip install --no-cache-dir -r /app/backend/requirements.txt -c /tmp/torch-constraints.txt

COPY backend /app/backend
COPY locales /app/locales

WORKDIR /app/backend

EXPOSE 5001

CMD ["python", "run.py"]
